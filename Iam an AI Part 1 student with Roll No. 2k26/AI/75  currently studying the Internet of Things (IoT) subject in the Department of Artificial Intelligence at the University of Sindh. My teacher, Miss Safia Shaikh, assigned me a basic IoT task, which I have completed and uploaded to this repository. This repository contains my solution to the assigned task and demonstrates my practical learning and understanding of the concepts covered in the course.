Q:3
data = {'a': 1, 'b': 2, 'c': 3}

reversed_data = {}

for key, value in data.items():
    reversed_data[value] = key

print(reversed_data)

Output: 
{1: 'a', 2: 'b', 3: 'c'}


Q:4
words = ['apple', 'ant', 'banana', 'ball', 'cat']

grouped = {}

for word in words:
    first_letter = word[0]

    if first_letter in grouped:
        grouped[first_letter].append(word)
    else:
        grouped[first_letter] = [word]

print(grouped)

Output: 
{
    'a': ['apple', 'ant'],
    'b': ['banana', 'ball'],
    'c': ['cat']
}
